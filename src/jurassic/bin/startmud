#!/bin/bash
# 쥬라기공원 머드 실행 (드라이버가 죽으면 10 초 뒤 다시 띄운다)
#   cd <설치 디렉터리>/bin && nohup ./startmud > /dev/null 2>&1 &
# 멈추려면: ./killmud   다시 띄우려면: ./killmud -r  (또는 운영자로 접속해 '0 다운')
cd "$(dirname "$0")"
BIN=$(pwd)
LOG=../lib/log/driver
mkdir -p "$LOG"

# 이미 떠 있으면 또 띄우지 않는다 (둘이 뜨면 나중 것의 드라이버는 포트가 겹쳐 계속 죽는다)
running() {	# pid 파일의 프로세스가 살아 있고 명령줄에 $2 가 있으면 참
	local pid
	pid=$(cat "$1" 2>/dev/null)
	[ -n "$pid" ] && [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null &&
		tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "$2"
}
if running "$BIN/startmud.pid" startmud || running "$BIN/driver.pid" "driver config.jurassic"; then
	echo "$(date) 이미 실행 중이라 시작하지 않음 (먼저 ./killmud)" | tee -a "$LOG/startmud.log" >&2
	exit 1
fi

echo $$ > "$BIN/startmud.pid"

while :; do
	echo "$(date) 드라이버 시작" >> "$LOG/startmud.log"
	./driver config.jurassic > "$LOG/driver.log" 2> "$LOG/driver.err" &
	echo $! > "$BIN/driver.pid"
	wait $!
	CODE=$?
	echo "$(date) 드라이버 종료 (코드 $CODE)" >> "$LOG/startmud.log"
	mv -f "$LOG/driver.log" "$LOG/driver.log.old" 2>/dev/null
	mv -f "$LOG/driver.err" "$LOG/driver.err.old" 2>/dev/null
	# 운영자가 정상적으로 내린 경우(-1) 는 다시 띄우지 않는다
	[ $CODE -eq 255 ] && break
	sleep 10
done
